# PUBLIC_INTERFACE
# React environment variables for The Daily Grind frontend.
# Rename this file to ".env" and adjust values as needed.

# Base URL for the backend API.
# If your backend runs on a different origin, set this to the full origin, e.g.:
# REACT_APP_API_BASE=https://api.example.com
# During local development with CRA proxy, you can leave this empty to use same-origin /api,
# and configure "proxy" in package.json to your backend dev server (default added: http://localhost:5000).
REACT_APP_API_BASE=
